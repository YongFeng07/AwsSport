#!/bin/bash
set -e

# ============================================================
# 1. 安裝套件
# ============================================================
yum update -y
yum install -y httpd php php-mysqlnd php-cli jq unzip mariadb105 git amazon-cloudwatch-agent

systemctl start httpd
systemctl enable httpd

# ============================================================
# 2. Clone 您的應用程式
# ============================================================
cd /var/www/html
git clone https://github.com/YongFeng07/AwsSport.git

cd AwsSport
mv sports-facility-booking/* ..
cd ../
rm -rf AwsSport

# ============================================================
# 3. 從 Secrets Manager 取得資料庫認證
# ============================================================
SECRET_JSON=$(aws secretsmanager get-secret-value \
    --secret-id "${secret_arn}" \
    --region "${aws_region}" \
    --query SecretString \
    --output text)

DB_HOST=$(echo $SECRET_JSON | jq -r .host)
DB_PORT=$(echo $SECRET_JSON | jq -r .port)
DB_NAME=$(echo $SECRET_JSON | jq -r .dbname)
DB_USER=$(echo $SECRET_JSON | jq -r .username)
DB_PASS=$(echo $SECRET_JSON | jq -r .password)

# ============================================================
# 4. 初始化資料庫
# ============================================================
cd /var/www/html
if [ -f schema.sql ]; then
    mariadb -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" < schema.sql
fi

# ============================================================
# 5. 設定 Apache 環境變數
# ============================================================
cat <<EOF > /etc/httpd/conf.d/assignment-env.conf
SetEnv DB_HOST "$DB_HOST"
SetEnv DB_PORT "$DB_PORT"
SetEnv DB_USER "$DB_USER"
SetEnv DB_PASS "$DB_PASS"
SetEnv DB_NAME "$DB_NAME"
SetEnv AWS_S3_BUCKET "${artifact_bucket}"
SetEnv AWS_S3_REGION "${aws_region}"
EOF

# ============================================================
# 6. 建立 .env 檔案（供應用程式使用）
# ============================================================
cat > /var/www/html/.env <<EOF
DB_HOST=$DB_HOST
DB_PORT=$DB_PORT
DB_USER=$DB_USER
DB_PASS=$DB_PASS
DB_NAME=$DB_NAME
AWS_S3_BUCKET=${artifact_bucket}
AWS_S3_REGION=${aws_region}
EOF

chown apache:apache /var/www/html/.env
chmod 640 /var/www/html/.env

# ============================================================
# 7. 增加檔案上傳限制
# ============================================================
tee /etc/php.d/99-uploads.ini <<EOF
upload_max_filesize = 10M
post_max_size = 12M
EOF

# ============================================================
# 8. 設定權限
# ============================================================
mkdir -p /var/www/html/uploads
chown -R apache:apache /var/www/html
chmod -R 755 /var/www/html
chmod -R 775 /var/www/html/uploads

# ============================================================
# 9. 安裝與設定 CloudWatch Agent（加分項目）
# ============================================================
cat > /opt/aws/amazon-cloudwatch-agent/etc/config.json <<'CWEOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/httpd/access_log",
            "log_group_name": "/aws/ec2/sports-facility-booking/apache-access",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7
          },
          {
            "file_path": "/var/log/httpd/error_log",
            "log_group_name": "/aws/ec2/sports-facility-booking/apache-error",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "SportsFacilityBooking",
    "metrics_collected": {
      "cpu": {
        "measurement": [
          {"name": "cpu_usage_idle", "rename": "CPU_IDLE", "unit": "Percent"},
          {"name": "cpu_usage_user", "rename": "CPU_USER", "unit": "Percent"},
          {"name": "cpu_usage_system", "rename": "CPU_SYSTEM", "unit": "Percent"}
        ],
        "totalcpu": true
      },
      "mem": {
        "measurement": [
          {"name": "mem_used_percent", "rename": "MEM_USED", "unit": "Percent"},
          {"name": "mem_available", "rename": "MEM_AVAILABLE", "unit": "Bytes"}
        ]
      },
      "disk": {
        "measurement": [
          {"name": "used_percent", "rename": "DISK_USED", "unit": "Percent"},
          {"name": "free", "rename": "DISK_FREE", "unit": "Bytes"}
        ],
        "resources": ["/"]
      }
    }
  }
}
CWEOF

# 啟動 CloudWatch Agent
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
    -a fetch-config \
    -m ec2 \
    -s \
    -c file:/opt/aws/amazon-cloudwatch-agent/etc/config.json

systemctl enable amazon-cloudwatch-agent
systemctl start amazon-cloudwatch-agent

# ============================================================
# 10. 重啟服務
# ============================================================
systemctl restart httpd
systemctl restart php-fpm

# ============================================================
# 11. 完成訊息
# ============================================================
echo "================================================"
echo "Deployment complete!"
echo "Database Host: $DB_HOST"
echo "Database Name: $DB_NAME"
echo "S3 Bucket: ${artifact_bucket}"
echo "CloudWatch Agent: Running"
echo "================================================"