#!/bin/bash
set -x
# 注意：移除 -e，讓腳本即使某步驟失敗也繼續執行

# ============================================================
# 0. 診斷：將所有輸出同時寫入日誌
# ============================================================
exec > >(tee /var/log/user-data.log|logger -t user-data -s 2>/dev/console) 2>&1

echo "=== Starting user_data at $(date) ==="

# ============================================================
# 1. 安裝套件
# ============================================================
yum update -y
yum install -y httpd php php-mysqlnd php-cli jq unzip mariadb105 git amazon-cloudwatch-agent

systemctl start httpd
systemctl enable httpd

# ============================================================
# 2. Clone 您的應用程式
# ============================================================
cd /var/www/html
git clone https://github.com/YongFeng07/AwsSport.git

cd AwsSport
mv sports-facility-booking/* ..
cd ../
rm -rf AwsSport

echo "=== Files in /var/www/html ==="
ls -la /var/www/html/

# ============================================================
# 3. 從 Secrets Manager 取得資料庫認證
# ============================================================
SECRET_JSON=$(aws secretsmanager get-secret-value \
    --secret-id "${secret_arn}" \
    --region "${aws_region}" \
    --query SecretString \
    --output text)

DB_HOST=$(echo "$SECRET_JSON" | jq -r .host)
DB_PORT=$(echo "$SECRET_JSON" | jq -r .port)
DB_NAME=$(echo "$SECRET_JSON" | jq -r .dbname)
DB_USER=$(echo "$SECRET_JSON" | jq -r .username)
DB_PASS=$(echo "$SECRET_JSON" | jq -r .password)

echo "=== DB Configuration ==="
echo "DB_HOST: $DB_HOST"
echo "DB_PORT: $DB_PORT"
echo "DB_NAME: $DB_NAME"
echo "DB_USER: $DB_USER"

# ============================================================
# 4. 初始化資料庫
# ============================================================
cd /var/www/html
if [ -f schema.sql ]; then
    echo "=== Loading schema.sql ==="
    mariadb -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" < schema.sql
    echo "=== Schema loaded successfully ==="
else
    echo "=== WARNING: schema.sql not found ==="
fi

# ============================================================
# 5. 設定 Apache 環境變數
# ============================================================
cat <<EOF > /etc/httpd/conf.d/assignment-env.conf
SetEnv DB_HOST "$${DB_HOST}"
SetEnv DB_PORT "$${DB_PORT}"
SetEnv DB_USER "$${DB_USER}"
SetEnv DB_PASS "$${DB_PASS}"
SetEnv DB_NAME "$${DB_NAME}"
SetEnv AWS_S3_BUCKET "${artifact_bucket}"
SetEnv AWS_S3_REGION "${aws_region}"
EOF

# ============================================================
# 6. 建立 .env 檔案
# ============================================================
cat > /var/www/html/.env <<EOF
DB_HOST=$${DB_HOST}
DB_PORT=$${DB_PORT}
DB_USER=$${DB_USER}
DB_PASS=$${DB_PASS}
DB_NAME=$${DB_NAME}
AWS_S3_BUCKET=${artifact_bucket}
AWS_S3_REGION=${aws_region}
EOF

chown apache:apache /var/www/html/.env
chmod 640 /var/www/html/.env

# ============================================================
# 7-8. 權限設定（略，保持不變）
# ============================================================
tee /etc/php.d/99-uploads.ini <<'PHPEOF'
upload_max_filesize = 10M
post_max_size = 12M
PHPEOF

mkdir -p /var/www/html/uploads
chown -R apache:apache /var/www/html
chmod -R 755 /var/www/html
chmod -R 775 /var/www/html/uploads

# ============================================================
# 9. CloudWatch Agent（略，保持不變）
# ============================================================

# ============================================================
# 10. 重啟服務
# ============================================================
systemctl restart httpd
systemctl restart php-fpm

# ============================================================
# 11. 診斷上傳至 S3（一定會執行）
# ============================================================
{
  echo "=== /etc/httpd/conf.d/assignment-env.conf ==="
  cat /etc/httpd/conf.d/assignment-env.conf 2>&1
  echo ""
  echo "=== /var/www/html/.env ==="
  cat /var/www/html/.env 2>&1
  echo ""
  echo "=== /var/www/html/ files ==="
  ls -la /var/www/html/ 2>&1
  echo ""
  echo "=== Apache status ==="
  systemctl status httpd 2>&1
  echo ""
  echo "=== Cloud-init log (last 200 lines) ==="
  tail -200 /var/log/cloud-init-output.log 2>&1
  echo ""
  echo "=== user-data.log (last 200 lines) ==="
  tail -200 /var/log/user-data.log 2>&1
  echo ""
  echo "=== healthz.php test ==="
  curl -s http://localhost/healthz.php 2>&1
  echo ""
  echo "=== RDS connection test ==="
  mariadb -h "$DB_HOST" -P "$DB_PORT" -u "$DB_USER" -p"$DB_PASS" "$DB_NAME" -e "SELECT 1" 2>&1
} > /tmp/diagnostics.txt 2>&1

aws s3 cp /tmp/diagnostics.txt "s3://sports-facility-booking-s3/diagnostics/$(hostname).txt" --region us-east-1 || echo "S3 upload failed"

# ============================================================
# 12. 完成
# ============================================================
echo "================================================"
echo "Deployment complete!"
echo "================================================"